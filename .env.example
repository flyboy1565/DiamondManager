# Template for the repo-root Django environment file.
# Copy to `.env` (gitignored) and fill in real values.

# --- YouTube fallback channel (test creds) ---
YOUTUBE_FALLBACK_CHANNEL_ID=
YOUTUBE_FALLBACK_CLIENT_ID=
YOUTUBE_FALLBACK_CLIENT_SECRET=
YOUTUBE_FALLBACK_REFRESH_TOKEN=
YOUTUBE_FALLBACK_PRIVACY=unlisted

# --- Per-org OAuth app (optional; not needed for fallback path) ---
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=
YOUTUBE_OAUTH_SUCCESS_REDIRECT=
YOUTUBE_OAUTH_ERROR_REDIRECT=

# --- Streaming relay (Django -> agent) ---
STREAMING_RELAY_ENABLED=False
STREAMING_RELAY_AGENT_URL=http://127.0.0.1:8088
STREAMING_RELAY_AGENT_TOKEN=change-me
STREAMING_SERVER_SRT_URL_DEFAULT=
STREAM_RECONCILE_TIMEOUT=180

# --- Secrets-at-rest encryption (Fernet key material; keep stable) ---
STREAMING_ENCRYPTION_KEY=
