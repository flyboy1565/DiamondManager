# Relay server defaults (optional)
STREAMING_SERVER_SRT_URL_DEFAULT=srt://your-server.example.com:10080

# Relay control agent (Django talks to this)
# RELAY_TOKEN is shared between the agent container and the Django backend.
RELAY_TOKEN=change-me
# Internal SRS RTMP address as seen from inside the agent container.
SRS_RTMP_BASE=rtmp://srs:1935

# Fallback YouTube channel (optional)
YOUTUBE_FALLBACK_CHANNEL_ID=
YOUTUBE_FALLBACK_CLIENT_ID=
YOUTUBE_FALLBACK_CLIENT_SECRET=
YOUTUBE_FALLBACK_REFRESH_TOKEN=
YOUTUBE_FALLBACK_PRIVACY=unlisted
